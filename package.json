{
  "name": "@atlashub/amf-experience-core",
  "version": "0.2.0",
  "description": "Headless reusable product primitives for AMF projects",
  "type": "module",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "docs/JOURNEY.md",
    "docs/ARTIFACTS.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "pack:artifact": "npm run build && node scripts/pack-artifact.mjs",
    "verify:artifact": "node scripts/verify-artifact.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=22"
  },
  "peerDependencies": {
    "@atlashub/amf-content-schema": "0.2.0"
  }
}
